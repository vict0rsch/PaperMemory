{
    "name": "papermemory",
    "version": "1.1.1",
    "description": "N/A",
    "type": "module",
    "scripts": {
        "browser": "npm run build:chrome && openBrowser=true node test/tmpBrowser.js",
        "build:chrome": "wxt build",
        "build:firefox": "wxt build --browser firefox",
        "build": "wxt build && wxt build --browser firefox",
        "dev:firefox": "wxt --browser firefox",
        "dev:watch": "WXT_NO_BROWSER=1 wxt",
        "dev": "wxt",
        "format": "prettier --write \"**/*.{js,mjs,json,yaml,yml,html,css,md}\"",
        "postinstall": "wxt prepare",
        "pretest": "npm run build:chrome",
        "submit:chrome:dry-run": "npm run submit:chrome -- --dry-run",
        "submit:chrome": "npm run zip:chrome && wxt submit --chrome-zip dist/papermemory-$npm_package_version-chrome.zip",
        "submit:dry-run": "npm run submit:chrome:dry-run && npm run submit:firefox:dry-run",
        "submit:firefox:dry-run": "npm run submit:firefox -- --dry-run",
        "submit:firefox": "npm run zip:firefox && wxt submit --firefox-zip dist/papermemory-$npm_package_version-firefox.zip --firefox-sources-zip dist/papermemory-$npm_package_version-sources.zip",
        "submit": "npm run submit:chrome && npm run submit:firefox",
        "test:file": "node --import ./register.mjs ./node_modules/.bin/mocha --exit",
        "test": "node --import ./register.mjs ./node_modules/.bin/mocha test/test-*.js --exclude test/test-sync.js --exit",
        "zip:chrome": "wxt zip",
        "zip:firefox": "wxt zip --browser firefox",
        "zip": "wxt zip && wxt zip --browser firefox"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vict0rsch/PaperMemory.git"
    },
    "author": "Victor Schmidt",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vict0rsch/PaperMemory/issues"
    },
    "homepage": "https://github.com/vict0rsch/PaperMemory",
    "dependencies": {
        "@octokit/request": "^10.0.16",
        "jquery": "^4.0.0",
        "tom-select": "^2.6.2"
    },
    "devDependencies": {
        "cloakbrowser": "^0.6.5",
        "expect": "^30.5.1",
        "glob": "^13.0.6",
        "heap": "^0.2.7",
        "jsdom": "^30.0.1",
        "mocha": "^12.0.1",
        "ora": "^9.4.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "puppeteer-core": "^25.11.0",
        "readline-sync": "^1.4.10",
        "uuid": "^14.0.2",
        "wxt": "^0.21.4",
        "yaml": "^2.9.1"
    }
}
