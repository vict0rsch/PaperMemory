        "extension": "^3.8.16",
        "glob": "^10.3.10",
        "heap": "^0.2.7",
        "jsdom": "^23.0.1",
        "mocha": "^11.7.5",
        "ora": "^5.4.1",
        "postcss": "^8.5.6",
        "puppeteer": "^24.16.0",
        "readline-sync": "^1.4.10",
        "rollup": "^4.45.0",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-delete": "^3.0.1",
        "rollup-plugin-postcss": "^4.0.2",
        "uuid": "^9.0.1",
