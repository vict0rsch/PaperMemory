{
    "name": "papermemory",
    "version": "1.1.0",
    "description": "N/A",
    "type": "module",
    "moduleDirectories": [
        "node_modules",
        "src"
    ],
    "scripts": {
        "dev": "rollup -c",
        "dev:watch": "concurrently \"rollup -c -w\" \"extension dev src/\"",
        "build": "NODE_ENV=production rollup -c",
        "pretest": "npm run dev",
        "test": "node --import ./register.mjs ./node_modules/.bin/mocha test/test-*.js --exclude test/test-sync.js --exit",
        "test:file": "node --import ./register.mjs ./node_modules/.bin/mocha --exit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vict0rsch/PaperMemory.git"
    },
    "author": "Victor Schmidt",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vict0rsch/PaperMemory/issues"
    },
    "homepage": "https://github.com/vict0rsch/PaperMemory",
    "dependencies": {
        "@octokit/request": "^8.1.6",
        "jquery": "^3.7.1",
        "select2": "^4.1.0-rc.0"
    },
    "devDependencies": {
        "@babel/core": "^7.0.0",
        "@prefresh/core": "^1.5.9",
        "@prefresh/utils": "^1.2.1",
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
